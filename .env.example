PORT=4000
# 토큰 서명용 비밀키. 운영 배포 전 반드시 무작위 값으로 교체하세요.
JWT_SECRET=stackfit-dev-secret-change-me

# 설정하면 PostgreSQL을 사용합니다 (영구 저장). 비워두면 로컬 SQLite로 자동 동작합니다 (로컬 개발용).
# DATABASE_URL=postgresql://user:password@host/dbname

# 공고 등록 시 사업자등록 진위확인에 쓰는 공공데이터포털 인증키(국세청_사업자등록정보 진위확인 및 상태조회 서비스).
# 비워두면 사업자등록번호 형식(검증번호)·개업일자만 확인합니다.
# NTS_API_KEY=

# 가입 이메일 인증(src/emailVerify.js) — Resend(https://resend.com) API 키와 보내는 주소.
# 둘 다 있어야 켜지고, 없으면 이메일 인증 없이 가입 즉시 로그인됩니다.
RESEND_API_KEY=
MAIL_FROM=김프리 <no-reply@kimfree.co.kr>
# 인증 링크에 쓸 사이트 주소(비우면 요청 주소 사용)
PUBLIC_BASE_URL=https://kimfree.co.kr
